# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube a GitHub (está en .gitignore).

# ── WhatsApp Cloud API (Meta) ─────────────────────────────
# Token permanente del usuario del sistema "recordaya-api"
WHATSAPP_ACCESS_TOKEN=
# Identificador del número de teléfono (WhatsApp Manager → API Setup)
WHATSAPP_PHONE_NUMBER_ID=
# Identificador de la cuenta de WhatsApp Business (WABA)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Versión de la Graph API
WHATSAPP_API_VERSION=v26.0
# Código de idioma de las plantillas (Spanish = es)
WHATSAPP_TEMPLATE_LANGUAGE=es
# "positional" si las variables de la plantilla son {{1}} {{2}}...
# "named" si son {{nombre}} {{fecha}}...
WHATSAPP_TEMPLATE_PARAM_FORMAT=positional

# ── Webhook ───────────────────────────────────────────────
# Texto que tú inventas; el mismo se pega en Meta al configurar el webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Clave secreta de la app (Meta for Developers → Configuración de la app → Básica)
WHATSAPP_APP_SECRET=

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=
# Clave secreta (sb_secret_...) o la antigua service_role. Solo servidor.
SUPABASE_SECRET_KEY=

# ── App ───────────────────────────────────────────────────
# URL pública (sin "/" final). QStash llama a APP_URL/api/jobs/...
# En desarrollo: la URL del túnel. En Vercel puede omitirse.
APP_URL=

# ── Upstash QStash (envíos programados) ───────────────────
# Desarrollo: QSTASH_DEV=true usa un QStash local (sin cuenta ni túnel; APP_URL=http://localhost:3000).
# Producción: QSTASH_DEV=false y completar token + signing keys (Upstash Console → QStash).
QSTASH_DEV=true
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Solo si tu cuenta usa otra región (ej. https://qstash-us-east-1.upstash.io)
QSTASH_URL=
# Demora máxima que permite tu plan; lo más lejano lo agenda /api/jobs/dispatch
QSTASH_MAX_DELAY_DAYS=7

# ── Seguridad interna ─────────────────────────────────────
# Clave para proteger los endpoints internos (genera una larga y aleatoria)
ADMIN_API_KEY=

# ── Panel web ─────────────────────────────────────────────
# Contraseña para entrar a /panel
PANEL_PASSWORD=
# Secreto para firmar la cookie de sesión (opcional; por defecto usa ADMIN_API_KEY)
PANEL_SESSION_SECRET=

# ── Supabase Auth (panel con usuarios; chatbot, T-03.2) ───
# Misma URL que SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_...). Solo identifica usuarios; los datos se leen con la clave secreta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Chatbot (T-03.5) ──────────────────────────────────────
# Interruptor global: solo "true" lo activa (apagado = ningún negocio usa el chatbot, todo sigue como antes)
CHATBOT_ENABLED=false
# Piloto: si tiene teléfonos (separados por coma), solo ellos pasan por el chatbot; vacío = sin restricción
CHATBOT_ALLOWLIST_PHONES=
# Generación con Gemini (capa gratuita). Solo servidor.
GEMINI_API_KEY=
# Modelos que un negocio puede elegir (coma). Los ids de Gemini no están fijados en el código: verifícalos en la documentación de Google
CHATBOT_ALLOWED_MODELS=
# Modelo que se usa cuando el negocio tiene llm_model = "default"
CHATBOT_DEFAULT_MODEL=
# Embeddings (Voyage). EMBEDDINGS_PROVIDER=fake solo para pruebas
VOYAGE_API_KEY=
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=voyage-4-lite
EMBEDDINGS_DIMENSIONS=1024
# Token aleatorio y largo por despliegue para detectar fuga del prompt
CHATBOT_PROMPT_CANARY=
# Límites
CHATBOT_DEFAULT_MONTHLY_BUDGET_USD=20
CHATBOT_GLOBAL_DAILY_BUDGET_USD=50
KNOWLEDGE_MAX_FILE_MB=10

# Login con la contraseña compartida del panel (PANEL_PASSWORD). Sin definir = activo.
# Poner "false" cuando el equipo ya entre con usuarios (Supabase Auth).
PANEL_LEGACY_LOGIN=

# Plantilla "utility" aprobada para retomar una conversación pasadas 24 h (vacío = deshabilitada)
WHATSAPP_REOPEN_TEMPLATE=

# Sal para el hash de IP en audit_log.ip_hash y en el límite de intentos del login legacy (cadena larga y aleatoria; nunca se versiona)
# Sin definir: audit_log.ip_hash queda vacío y el límite de login usa una sal fija
AUDIT_IP_SALT=
