{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "recordaya-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "recordaya-prod-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "recordaya-video",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.env.local",
        "node_modules/next/dist/bin/next",
        "start",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}
